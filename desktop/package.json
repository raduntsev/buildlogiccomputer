{
  "name": "logic-lab",
  "productName": "Logic Lab",
  "version": "3.5.0",
  "description": "Logic Lab — logic gate puzzle game",
  "main": "main.js",
  "author": "Logic Lab",
  "build": {
    "appId": "ru.logiclab.game",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "index.html",
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LogicLab-Portable-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "productName": "Logic Lab",
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**"
    ],
    "extraFiles": [
      {
        "from": "steam_appid.txt",
        "to": "steam_appid.txt"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "executableName": "logiclab",
      "icon": "build/icon.png"
    },
    "afterPack": "scripts/afterPack.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3",
    "pe-library": "^1.0.1"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win dir portable --x64",
    "dist:linux": "electron-builder --linux dir --x64",
    "dist:steam": "electron-builder --win dir --linux dir --x64"
  }
}